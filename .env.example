DATABASE_URL=postgresql://user:password@localhost:5432/pc-lock-control

# Authentication password for the web app login page
APP_PASSWORD=your-secure-password-here

# Optional: secret used to sign session cookies (any long random string).
# If unset, one is derived from APP_PASSWORD, so changing the password logs everyone out.
SESSION_SECRET=

# Optional: set to true when running the production build over plain http (e.g. on a LAN
# without HTTPS); otherwise the browser refuses the secure session cookie and login loops.
INSECURE_COOKIES=
